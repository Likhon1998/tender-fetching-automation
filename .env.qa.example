# Copy to .env.qa for: docker compose --env-file .env.qa --profile qa up --build

# Database parts (composed into DATABASE_URL by the app)
DB_DRIVER=postgresql+asyncpg
DB_USER=postgres
DB_PASSWORD=qasecret
DB_HOST=db
DB_PORT=5432
DB_NAME=tender-fetching
DB_DISABLE_PREPARED_STATEMENTS=false
DB_PUBLISH_PORT=5434

# Security — use a different secret from dev
JWT_SECRET=qa-change-me-use-a-long-random-string-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_NAME=Tender Automation API (qa)
ENVIRONMENT=qa
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin seed
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@egeneration.com
ADMIN_FULL_NAME=System Administrator
ADMIN_PASSWORD=AdminPass12345
RUN_SEEDS=true

# Firecrawl
FIRECRAWL_API_KEY=
FIRECRAWL_MAX_CONCURRENT=3
FIRECRAWL_DELAY_SECONDS=1.0

# Scheduling & ingestion
TIMEZONE=Asia/Dhaka
SCHEDULER_ENABLED=true
MAX_PAGES_PER_SITE=5
TENDER_CUTOFF_YEAR=2026

# Login throttling
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Published ports / frontend (QA serves via nginx on FRONTEND_PORT)
BACKEND_PORT=8001
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8001
