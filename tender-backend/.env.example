################################################################################
# Tender Automation API — environment template (copy to .env for deploy)
################################################################################

# Database — set each part; the app builds the full URL
DB_DRIVER=mysql+asyncmy
DB_USER=USER
DB_PASSWORD=PASSWORD
DB_HOST=HOST
DB_PORT=3306
DB_NAME=tender-fetching
DB_DISABLE_PREPARED_STATEMENTS=false

# Or set a full URL instead of the parts above:
# DATABASE_URL=mysql+asyncmy://USER:PASSWORD@HOST:3306/tender-fetching

# Security — generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_NAME=Tender Automation API
ENVIRONMENT=production
CORS_ORIGINS=https://YOUR_FRONTEND_DOMAIN

# Admin seed (python -m scripts.seed_admin) — password at least 8 characters
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=System Administrator
ADMIN_PASSWORD=CHANGE_ME_BEFORE_SEEDING

# Firecrawl
FIRECRAWL_API_KEY=
FIRECRAWL_MAX_CONCURRENT=3
FIRECRAWL_DELAY_SECONDS=1.0

# Scheduling & ingestion
TIMEZONE=Asia/Dhaka
SCHEDULER_ENABLED=true
MAX_PAGES_PER_SITE=5
TENDER_CUTOFF_YEAR=2026

# Login throttling
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
