# ---- Database (Supabase) ----
# Supabase Dashboard > Project Settings > Database > Connection string > URI
# Use the SESSION POOLER (port 5432) if available.
# Swap the "postgresql://" prefix for "postgresql+asyncpg://".
DATABASE_URL=postgresql+asyncpg://postgres.abcdefgh:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Set to true ONLY if you are using the transaction pooler on port 6543.
DB_DISABLE_PREPARED_STATEMENTS=false

# ---- JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- App ----
APP_NAME=Tender Automation API
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Admin seed (used by scripts/seed_admin.py only) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@egeneration.com
ADMIN_FULL_NAME=System Administrator
ADMIN_PASSWORD=CHANGE_ME_BEFORE_SEEDING

# ---- Firecrawl ----
# Never commit a real key. Keep it here in .env only.
FIRECRAWL_API_KEY=fc-your-key-here
FIRECRAWL_MAX_CONCURRENT=3
FIRECRAWL_DELAY_SECONDS=1.0

# ---- Ingestion ----
# Scheduled scrape times are wall-clock times in this zone.
TIMEZONE=Asia/Dhaka
SCHEDULER_ENABLED=true

MAX_PAGES_PER_SITE=5
TENDER_CUTOFF_YEAR=2026

# ---- Login throttling ----
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
